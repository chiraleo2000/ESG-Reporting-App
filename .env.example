# Copy to .env / backend/.env for local and Docker (compose env_file)

NODE_ENV=development
PORT=2047
HOST=0.0.0.0

DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5434/esg_reporting
REDIS_URL=redis://localhost:6379

# Access + refresh JWT secrets (min 32 chars each)
JWT_SECRET=change_me_access_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_jwt_secret_min_32_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
MFA_ENCRYPTION_KEY=change_me_mfa_encryption_key_32ch

CORS_ORIGIN=http://localhost:2048
TRUST_PROXY=1

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=esg_reporting
